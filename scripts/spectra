#!/usr/bin/env bash
# Spectra Finance Alpha operator CLI.
set -Eeuo pipefail

INSTALL_ROOT="${SPECTRA_ALPHA_HOME:-$HOME/SpectraFinance-Alpha}"
CORE_DIR="$INSTALL_ROOT/spectra-core"
API_DIR="$INSTALL_ROOT/spectra-hummingbot-api"
LOCAL_BIN="$HOME/.local/bin"
COMPOSE_KIND="$(cat "$INSTALL_ROOT/.compose-kind" 2>/dev/null || true)"
CORE_UNIT="spectra-alpha-core.service"

compose() {
  cd "$API_DIR"
  case "$COMPOSE_KIND" in
    docker) docker compose -p spectra-alpha -f docker-compose.alpha.yml "$@" ;;
    podman) podman-compose -p spectra-alpha -f docker-compose.alpha.yml "$@" ;;
    *) echo "[SPECTRA] Unknown Compose runtime: $COMPOSE_KIND" >&2; return 1 ;;
  esac
}

systemd_user_available() {
  command -v systemctl >/dev/null 2>&1 && systemctl --user show-environment >/dev/null 2>&1
}

start_core_fallback() {
  "$LOCAL_BIN/spectra-alpha-start-api"
  if [[ -f "$INSTALL_ROOT/condor.pid" ]] && kill -0 "$(cat "$INSTALL_ROOT/condor.pid")" 2>/dev/null; then
    echo "Spectra Intelligence is already running."
    return 0
  fi
  cd "$CORE_DIR"
  nohup "$CORE_DIR/.venv/bin/python" "$CORE_DIR/main.py" > "$INSTALL_ROOT/condor.log" 2>&1 &
  echo $! > "$INSTALL_ROOT/condor.pid"
  for _ in $(seq 1 60); do
    curl -fsS http://127.0.0.1:8088/ >/dev/null 2>&1 && return 0
    sleep 2
  done
  tail -80 "$INSTALL_ROOT/condor.log" || true
  return 1
}

stop_core_fallback() {
  if [[ -f "$INSTALL_ROOT/condor.pid" ]]; then
    local pid
    pid="$(cat "$INSTALL_ROOT/condor.pid")"
    if kill -0 "$pid" 2>/dev/null; then
      command_line="$(ps -p "$pid" -o args= 2>/dev/null || true)"
      if [[ "$command_line" == *"$CORE_DIR/main.py"* ]]; then
        kill -TERM "$pid"
        for _ in $(seq 1 20); do
          kill -0 "$pid" 2>/dev/null || break
          sleep 0.5
        done
      else
        echo "Refusing to signal PID $pid: it is not the Spectra Core main process." >&2
        return 1
      fi
    fi
    rm -f "$INSTALL_ROOT/condor.pid"
  fi
}

case "${1:-status}" in
  start)
    if systemd_user_available && [[ -f "$HOME/.config/systemd/user/$CORE_UNIT" ]]; then
      systemctl --user start "$CORE_UNIT"
    else
      start_core_fallback
    fi
    if command -v xdg-open >/dev/null 2>&1; then
      xdg-open http://127.0.0.1:8088/overview >/dev/null 2>&1 || true
    fi
    ;;
  stop)
    if systemd_user_available && [[ -f "$HOME/.config/systemd/user/$CORE_UNIT" ]]; then
      systemctl --user stop "$CORE_UNIT" || true
      stop_core_fallback
    else
      stop_core_fallback
    fi
    # Stop, never remove, existing containers and their persistent volumes.
    compose stop
    ;;
  restart)
    "$0" stop
    "$0" start
    ;;
  status)
    if systemd_user_available && [[ -f "$HOME/.config/systemd/user/$CORE_UNIT" ]]; then
      systemctl --user --no-pager --full status "$CORE_UNIT" || true
    elif [[ -f "$INSTALL_ROOT/condor.pid" ]] && kill -0 "$(cat "$INSTALL_ROOT/condor.pid")" 2>/dev/null; then
      echo "Spectra Intelligence process: running"
    else
      echo "Spectra Intelligence process: stopped"
    fi
    compose ps
    ;;
  logs)
    if systemd_user_available && [[ -f "$HOME/.config/systemd/user/$CORE_UNIT" ]]; then
      journalctl --user -u "$CORE_UNIT" -n 100 -f
    else
      tail -n 100 -f "$INSTALL_ROOT/condor.log"
    fi
    ;;
  doctor)
    "$LOCAL_BIN/spectra-alpha-doctor"
    ;;
  backup)
    "$LOCAL_BIN/spectra-alpha-backup"
    ;;
  update)
    "$LOCAL_BIN/spectra-update-alpha-api"
    ;;
  *)
    echo "Usage: spectra {start|stop|restart|status|logs|doctor|backup|update}"
    exit 2
    ;;
esac
