[Unit]
Description=Spectra Finance Alpha Core (paper-only)
Documentation=https://github.com/andredepaulnash-cmd/spectra-finance-core
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
Environment=SPECTRA_ALPHA_HOME=@INSTALL_ROOT@
WorkingDirectory=@INSTALL_ROOT@/spectra-core
EnvironmentFile=@INSTALL_ROOT@/spectra-core/.env
UMask=0077
ExecStartPre=@LOCAL_BIN@/spectra-alpha-start-api
ExecStart=@INSTALL_ROOT@/spectra-core/.venv/bin/python @INSTALL_ROOT@/spectra-core/main.py
Restart=on-failure
RestartSec=10
TimeoutStartSec=300
TimeoutStopSec=45
KillSignal=SIGINT

[Install]
WantedBy=default.target
